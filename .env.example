# Admin Portal Authentication (build-time environment variables)
# Set these in your Vercel project environment variables or local .env
VITE_ADMIN_EMAIL="owner@example.com"
VITE_ADMIN_PASSPHRASE="your_secure_passphrase_here"

# Supabase Hosted Backend & Storage (Free hosted backend)
# Obtain these from your Supabase Project Dashboard -> Settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Vite native config warning suppression
VITE_CONFIG_NATIVE_IGNORE_WARNING="true"
